---
import Base from '../../layouts/Base.astro';
import {
  getManifest,
  authorNameJa,
  authorDates,
  getDocument,
  marker,
} from '../../lib/corpus';
import { author as authorUrl, text as textUrl } from '../../lib/paths';

const manifest = getManifest();

// Flat alphabetical listing, ordered by the English name as the source index
// orders it — the Japanese renderings are mostly katakana transliterations, so
// sorting on them would scatter related figures apart.
const authors = [...manifest.authors].sort((a, b) =>
  a.name.localeCompare(b.name)
);

const titleOf = (id: string, fallback: string) =>
  getDocument(id)?.title ?? fallback;
---

<Base
  title="教父一覧"
  description="本文庫に収録する教父と著作の総目録。"
  wide
>
  <h1>教父一覧</h1>
  <p>
    教父 {manifest.counts.authors} 名、{manifest.counts.works} 作品の総目録です。
    聖人・教会博士の別、および偽作・会議の種別を原典目録にしたがって注記しています。
  </p>

  <div class="index-list">
    {
      authors.map((a) => {
        const dates = authorDates(a);
        return (
          <section class="entry">
            <h2 class="entry-name">
              <a href={authorUrl(a.slug)}>{authorNameJa(a.name)}</a>
              {(a.markers ?? []).map((k) => (
                <span class={`mark mark-${marker(k).tone}`}>[{marker(k).ja}]</span>
              ))}
              <span class="entry-en">
                {a.name}
                {dates ? `（${dates}）` : ''}
              </span>
            </h2>
            <ul class="entry-works">
              {a.works.map((w) => (
                <li>
                  <a href={textUrl(w.id)}>{titleOf(w.id, w.title!)}</a>
                  {(w.markers ?? []).map((k) => (
                    <span class={`mark mark-${marker(k).tone}`}>
                      [{marker(k).ja}]
                    </span>
                  ))}
                </li>
              ))}
            </ul>
          </section>
        );
      })
    }
  </div>
</Base>

---
import Base from '../layouts/Base.astro';
import { getManifest, progress, authorNameJa } from '../lib/corpus';
import { author as authorUrl, authors as authorsUrl } from '../lib/paths';

const manifest = getManifest();
const p = progress();

// A short standing list of the Fathers most readers arrive looking for.
const featured = [
  'Augustine of Hippo',
  'John Chrysostom',
  'Athanasius',
  'Irenaeus of Lyons',
  'Tertullian',
  'Origen',
  'Basil the Great',
  'Jerome',
  'Ambrose',
  'Justin Martyr',
  'Ignatius of Antioch',
  'Cyprian of Carthage',
];

const byName = new Map(manifest.authors.map((a) => [a.name, a]));
const cards = featured.map((n) => byName.get(n)).filter(Boolean);

const fmt = (n: number) => n.toLocaleString('ja-JP');
---

<Base>
  <h1>古代教会の教父たち</h1>

  <p>
    使徒教父から大グレゴリウスにいたるまで、古代教会が書き遺した著作を
    ひとつの文庫に収めます。教父 {fmt(manifest.counts.authors)} 名、
    {fmt(manifest.counts.works)} 作品、{fmt(manifest.counts.documents)} 篇。
    護教論、書簡、説教、注解、教会史、修道規則——四世紀にわたる
    キリスト教思想の形成過程を、原典に即してたどることができます。
  </p>

  <p>
    全文を無償で公開しています。会員登録も広告もありません。
    本文は自由に複製・引用していただけます。
  </p>

  <div class="progress">
    <strong>翻訳の進捗</strong><br />
    {fmt(p.translatedDocuments)} / {fmt(p.documents)} 篇 　（
    {p.percent.toFixed(1)}％ ／ 語数比）
    <div class="bar">
      <span style={`width:${Math.max(p.percent, 0.4).toFixed(2)}%`}></span>
    </div>
    {
      p.translatedDocuments === 0 && (
        <p style="margin:0.7rem 0 0">
          翻訳はこれから開始します。未訳の文書は原文（英語）を表示しています。
        </p>
      )
    }
  </div>

  <h2>主要な教父</h2>
  <ul class="author-list">
    {
      cards.map((a) => (
        <li>
          <a href={authorUrl(a!.slug)}>{authorNameJa(a!.name)}</a>
          {a!.isSaint && <span class="badge badge-saint">聖人</span>}
          {a!.isDoctor && <span class="badge badge-doctor">教会博士</span>}
          <span class="en">{a!.name}{a!.dates ? `（${a!.dates}）` : ''}</span>
          <span class="count">{a!.works.length} 作品</span>
        </li>
      ))
    }
  </ul>

  <p>
    <a href={authorsUrl()}>教父一覧（全 {manifest.counts.authors} 名）→</a>
  </p>
</Base>

---
import Base from '../../layouts/Base.astro';
import {
  allDocumentIds,
  getDocument,
  locate,
  authorNameJa,
  type Block,
} from '../../lib/corpus';
import { renderInline } from '../../lib/render';
import { author as authorUrl, text as textUrl } from '../../lib/paths';

export function getStaticPaths() {
  return allDocumentIds().map((id) => ({ params: { id } }));
}

const { id } = Astro.params;
const doc = getDocument(id!)!;
const place = locate(id!);

const heading = doc.title ?? doc.titleEn ?? id;
const blocks: Block[] = doc.translated ? doc.blocks : doc.blocksEn;

// Number the notes once, then index them by the block they annotate so each
// passage can carry a marker back to its note and the note back to it.
const numbered = doc.notes.map((n, i) => ({ ...n, n: i + 1 }));
const notesByBlock = new Map<number, typeof numbered>();
for (const note of numbered) {
  if (note.block === undefined) continue;
  if (!notesByBlock.has(note.block)) notesByBlock.set(note.block, []);
  notesByBlock.get(note.block)!.push(note);
}

const tag = (t: string) =>
  t === 'heading' ? 'h2' : t === 'subheading' ? 'h3' : t === 'quote' ? 'blockquote' : 'p';
---

<Base
  title={heading}
  description={
    place
      ? `${authorNameJa(place.author.name)}『${heading}』の日本語訳。`
      : `${heading} — 教父文庫`
  }
>
  <h1>{heading}</h1>

  <div class="doc-meta">
    {
      place && (
        <>
          <a href={authorUrl(place.author.slug)}>
            {authorNameJa(place.author.name)}
          </a>
          {place.work.id !== id && (
            <> ／ <a href={textUrl(place.work.id)}>{place.work.title}</a></>
          )}
          <br />
        </>
      )
    }
    {doc.titleEn && doc.title && <>{doc.titleEn}<br /></>}
    {doc.titleAltEn && <>別題 {doc.titleAltEn}<br /></>}
    {doc.words > 0 && <>約 {doc.words.toLocaleString('ja-JP')} 語（原文）</>}
  </div>

  {
    !doc.translated && blocks.length > 0 && (
      <div class="notice">
        <strong>この文書はまだ翻訳されていません。</strong>
        以下に底本の英語原文を表示しています。訳文が用意でき次第、差し替えられます。
      </div>
    )
  }

  {
    doc.isToc && doc.children.length > 0 && (
      <ul class="work-tree">
        {doc.children.map((c) => {
          const child = getDocument(c.id);
          return (
            <li>
              <a
                href={textUrl(c.id)}
                class={child?.translated ? undefined : 'pending'}
              >
                {child?.title ?? c.label}
              </a>
              {child?.title && <span class="en">{c.label}</span>}
              {!child?.translated && <span class="count">未訳</span>}
            </li>
          );
        })}
      </ul>
    )
  }

  <div class={doc.translated ? undefined : 'en-body'}>
    {
      blocks.map((b, i) => {
        const T = tag(b.type);
        const here = notesByBlock.get(i);
        const markers = here
          ? here
              .map(
                (n) =>
                  `<a class="note-ref" id="ref-${n.n}" href="#note-${n.n}" ` +
                  `aria-label="訳注${n.n}へ">［注${n.n}］</a>`
              )
              .join('')
          : '';
        return <T id={`block-${i}`} set:html={renderInline(b.text) + markers} />;
      })
    }
  </div>

  {
    !doc.isToc && blocks.length === 0 && (
      <p class="pending">この文書には本文がありません（底本に収録なし）。</p>
    )
  }

  {
    doc.notes.length > 0 && (
      <section class="notes">
        <h2>訳注</h2>
        <p class="notes-intro">
          本文は機械翻訳を基礎としています。訳者が判断に迷った箇所、および
          底本そのものの誤りと思われる箇所を以下に記します。
        </p>
        <ol>
          {numbered.map((n) => (
            <li id={`note-${n.n}`}>
              <span class={`note-kind note-${n.kind}`}>
                {n.kind === 'source' ? '底本' : '訳語'}
              </span>
              {n.block !== undefined ? (
                <a class="note-locus" href={`#ref-${n.n}`}>
                  {n.locus ?? '本文'}
                </a>
              ) : (
                n.locus && <span class="note-locus">{n.locus}</span>
              )}
              <span set:html={renderInline(n.note)} />
            </li>
          ))}
        </ol>
      </section>
    )
  }

  {
    place && (
      <p style="margin-top:3rem">
        <a href={authorUrl(place.author.slug)}>
          ← {authorNameJa(place.author.name)} の著作一覧へ
        </a>
      </p>
    )
  }
</Base>

---
import '../styles/global.css';
import { home, authors, about, withBase } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
  wide?: boolean;
}

const { title, description, wide = false } = Astro.props;

const SITE = '教父文庫';
const SERIES = '古代キリスト教文献集成';
const fullTitle = title ? `${title}｜${SITE}` : `${SITE}｜${SERIES}`;
const desc =
  description ??
  '使徒教父から大グレゴリウスにいたる古代教会の著作を収める文庫。全文を無償で公開しています。';

const path = Astro.url.pathname;
const root = home();
// Compare against base-prefixed hrefs, and treat the root tab as exact so it
// is not marked current on every page.
const isCurrent = (href: string) =>
  href === root
    ? path === root || path === root.replace(/\/$/, '')
    : path.startsWith(href);

const tabs = [
  { href: root, label: 'ホーム' },
  { href: authors(), label: '教父一覧' },
  { href: about(), label: 'このサイトについて' },
];
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
  </head>
  <body>
    <header class="masthead">
      <div class="masthead-inner">
        <div class="wordmark">
          <a href={root}>{SITE}</a>
          <span class="series">{SERIES}</span>
        </div>
        <nav class="tabs" aria-label="メインナビゲーション">
          {
            tabs.map((t) => (
              <a href={t.href} aria-current={isCurrent(t.href) ? 'page' : undefined}>
                {t.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>
    <div class="rule-bar">古代教会 教父著作集</div>

    <main class={wide ? 'wide' : undefined}>
      <slot />
    </main>

    <footer>
      <div class="footer-note">
        <p>
          底本｜<em>Ante-Nicene Fathers</em>／<em>Nicene and Post-Nicene Fathers</em>
          （Philip Schaff ほか編、1885–1900年）。保護期間満了。
          本文は
          <a
            href="https://creativecommons.org/publicdomain/zero/1.0/deed.ja"
            rel="license noopener"
            target="_blank">CC0 1.0</a
          >。複製・改変・再配布は自由です。
        </p>
        <p>
          誤りのご指摘は
          <a
            href="https://github.com/crusadesoft/japanese-new-advent/issues"
            rel="noopener"
            target="_blank">こちら</a
          >まで。随時反映します。
        </p>
      </div>
      <div class="footer-bar">
        教父文庫 ｜ 本文はパブリックドメイン ｜
        <a href={about()}>翻訳について</a>
      </div>
    </footer>
  </body>
</html>
